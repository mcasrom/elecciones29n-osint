[Unit]
Description=Elecciones 29N - generación estática
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/Desktop/elecciones29n-osint
ExecStart=%h/Desktop/elecciones29n-osint/scripts/run_daily.sh
Environment=TZ=Europe/Madrid
StandardOutput=append:%h/.local/state/elecciones29n/run.log
StandardError=append:%h/.local/state/elecciones29n/run.log

[Install]
WantedBy=default.target
