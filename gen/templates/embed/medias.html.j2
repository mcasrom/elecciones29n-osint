<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="robots" content="noindex,nofollow">
<title>Media 29N · tabla para incrustar</title>
<link rel="stylesheet" href="/css/main.css?v={{ build_ts }}">
<style>
body.embed{background:var(--panel);padding:0}
.embed-wrap{max-width:760px;margin:0 auto;padding:14px 16px;font-size:14px}
.embed-head{display:flex;justify-content:space-between;gap:10px;align-items:baseline;margin-bottom:8px}
.embed-head strong{font-size:16px}
.embed-wrap table{font-size:13px}
.embed-wrap th,.embed-wrap td{padding:7px 8px}
.embed-foot{margin-top:8px;font-size:12px;color:var(--muted)}
.embed-foot a{color:var(--accent2)}
</style>
</head>
<body class="embed">
<main class="embed-wrap">
  <div class="embed-head"><strong>Media 29N</strong><span class="muted small">{{ updated_at }}</span></div>
  <div class="tablewrap"><table>
    <thead><tr><th>Partido</th><th>Media</th><th>Rango</th><th>Sondeos</th></tr></thead>
    <tbody>
    {% for p in parties_table[:7] %}
      <tr><td><strong>{{ p.party }}</strong></td><td class="num">{{ fmt_pct(p.mean) }}%</td><td class="num">{{ fmt_pct(p.min) }}–{{ fmt_pct(p.max) }}</td><td class="num">{{ p.n }}</td></tr>
    {% endfor %}
    </tbody>
  </table></div>
  <p class="embed-foot"><a href="{{ site_url }}/?utm_source=embed&amp;utm_medium=iframe" target="_blank" rel="noopener">Observatorio 29N</a> · {{ n_polls }} sondeos · media con rango, <strong>no un pronóstico</strong>.</p>
</main>
</body>
</html>
