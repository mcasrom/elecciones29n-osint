<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="robots" content="noindex,nofollow">
<title>Hemiciclo 29N · panel para incrustar</title>
<link rel="stylesheet" href="/css/main.css?v={{ build_ts }}">
<style>
body.embed{background:var(--panel);padding:0}.embed-wrap{max-width:760px;margin:0 auto;padding:14px 16px}
.embed-head{display:flex;justify-content:space-between;gap:10px;align-items:baseline;margin-bottom:10px}
.embed-head strong{font-size:16px}.embed-blocks{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin-bottom:10px}
.embed-blocks div{border:1px solid var(--line);border-radius:8px;padding:8px 10px}.embed-blocks b{display:block;font-size:24px}.embed-blocks span{font-size:11px;color:var(--muted)}
.embed-wrap table{font-size:13px}.embed-wrap th,.embed-wrap td{padding:6px 8px}
.embed-foot{margin-top:8px;font-size:12px;color:var(--muted)}.embed-foot a{color:var(--accent2)}
</style>
</head>
<body class="embed">
<main class="embed-wrap">
  {% if hemicycle %}
  {% set h = hemicycle[-1] %}
  <div class="embed-head"><strong>Hemiciclo 29N</strong><span class="muted small">{{ h.label }} · {{ h.n_polls }} sondeos</span></div>
  <div class="embed-blocks">
    <div><span>PP + VOX</span><b>{{ h.blocks.right }}</b><span>{{ 'mayoría' if h.majority == 'right' else 'escaños' }}</span></div>
    <div><span>PSOE + Sumar</span><b>{{ h.blocks.left }}</b><span>{{ 'mayoría' if h.majority == 'left' else 'escaños' }}</span></div>
    <div><span>Otros</span><b>{{ h.blocks.others }}</b><span>residual</span></div>
  </div>
  <div class="tablewrap"><table>
    <thead><tr><th>Partido</th><th>Escaños</th></tr></thead>
    <tbody>{% for r in h.seats %}<tr><td><strong>{{ r.party }}</strong></td><td class="num">{{ r.seats }}</td></tr>{% endfor %}</tbody>
  </table></div>
  <p class="embed-foot"><a href="{{ site_url }}/hemiciclo.html?utm_source=embed&amp;utm_medium=iframe" target="_blank" rel="noopener">Observatorio 29N</a> · D'Hondt nacional, 350 escaños · no es una proyección.</p>
  {% endif %}
</main>
</body>
</html>
