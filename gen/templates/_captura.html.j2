<section class="subscribe" id="aviso" aria-labelledby="aviso-title">
  <div class="subscribe-copy">
    <p class="eyebrow">Aviso por correo</p>
    <h2 id="aviso-title">Avísame cuando cambie la media o salga un sondeo nuevo</h2>
    <p>Un correo cuando haya un cambio en los datos. Sin pronósticos, sin ruido y sin cookies. Baja en un clic.</p>
  </div>
  <form class="subform" data-29n-subscribe novalidate>
    <label class="sr-only" for="sub-email">Tu correo electrónico</label>
    <input id="sub-email" name="email" type="email" inputmode="email" autocomplete="email" required placeholder="tu@correo.com">
    <button type="submit">Recibir aviso</button>
    <p class="submsg" role="status" aria-live="polite"></p>
    <p class="sublegal">Doble confirmación · <a href="/privacidad.html">Privacidad</a> · <a href="/cambios.xml">RSS de cambios</a></p>
    <input class="hp" name="website" type="text" tabindex="-1" autocomplete="off" aria-hidden="true">
  </form>
  <noscript><p class="sublegal">Para suscribirte necesitas JavaScript. También puedes seguir los cambios por <a href="/cambios.xml">RSS</a>.</p></noscript>
</section>
<script>
(function(){
  var form = document.querySelector('form[data-29n-subscribe]');
  if (!form) return;
  var input = form.querySelector('input[name="email"]');
  var msg = form.querySelector('.submsg');
  var button = form.querySelector('button[type="submit"]');
  var hp = form.querySelector('input[name="website"]');
  function say(text, bad){
    if (!msg) return;
    msg.textContent = text;
    msg.className = 'submsg' + (bad ? ' bad' : ' ok');
  }
  form.addEventListener('submit', function(ev){
    ev.preventDefault();
    if (hp && hp.value) { say('Revisa tu correo para confirmar.', false); return; }
    var email = (input.value || '').trim();
    if (!email || email.indexOf('@') < 1) { say('Escribe un correo válido.', true); input.focus(); return; }
    var q = new URLSearchParams(location.search);
    var payload = {
      email: email,
      source: '29n',
      page: location.pathname,
      utm_source: q.get('utm_source') || '',
      utm_medium: q.get('utm_medium') || '',
      utm_campaign: q.get('utm_campaign') || '',
      referrer: document.referrer || ''
    };
    button.disabled = true;
    button.textContent = 'Enviando…';
    say('', false);
    fetch('/api/subscribe', {
      method: 'POST',
      headers: {'Content-Type': 'application/json'},
      body: JSON.stringify(payload)
    }).then(function(res){
      if (res.ok) {
        say('Revisa tu correo: te he enviado un enlace para confirmar.', false);
        form.reset();
      } else if (res.status === 400) {
        say('El correo no parece válido.', true);
      } else if (res.status === 429) {
        say('Demasiados intentos. Prueba de nuevo en unos minutos.', true);
      } else {
        say('No he podido enviar el correo. Inténtalo más tarde o usa el RSS.', true);
      }
    }).catch(function(){
      say('No he podido conectar. Inténtalo más tarde o usa el RSS.', true);
    }).then(function(){
      button.disabled = false;
      button.textContent = 'Recibir aviso';
    });
  });
})();
</script>
