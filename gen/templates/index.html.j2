{% include "_footer.html.j2" %}
<script>
(function(){
  var body = document.body, banner = document.getElementById('stale-banner');
  if (banner && body.dataset.blackout !== '1') {
    var iso = body.dataset.updatedIso;
    if (iso) {
      var age = (Date.now() - new Date(iso).getTime()) / 36e5;
      var upd = new Date(iso), now = new Date();
      var missedToday = now.getHours() >= 9 && upd.toDateString() !== now.toDateString();
      if (age > 26 || missedToday) {
        banner.hidden = false;
        var el = document.getElementById('stale-age');
        if (el) el.textContent = Math.floor(age);
        var hs = document.getElementById('hstatus');
        if (hs) hs.innerHTML = '<span class="dot off"></span> SIN ACTUALIZAR · hace ' + Math.floor(age) + ' h';
      }
    }
  }
  var tabs = document.querySelectorAll('.tab[data-tab]');
  var panels = document.querySelectorAll('.tabpanel');
  function show(id){
    panels.forEach(function(p){p.classList.toggle('active', p.id === 'tab-' + id);});
    tabs.forEach(function(t){var on = t.dataset.tab === id; t.classList.toggle('active', on); t.setAttribute('aria-selected', on ? 'true' : 'false');});
    if (history.replaceState) history.replaceState(null, '', id === 'agregado' ? location.pathname : '#' + id);
  }
  tabs.forEach(function(t){ t.addEventListener('click', function(){ show(t.dataset.tab); }); });
  if (location.hash) {
    var h = location.hash.replace('#','');
    if (document.getElementById('tab-' + h)) show(h);
  }
})();
</script>
