{% set page_title = "Sondeos elecciones generales 29N 2026 · media agregada con rango" %}
{% set page_desc = "Media agregada de los sondeos publicados para las elecciones generales del 29 de noviembre de 2026, con rango mínimo–máximo, fuentes y datos abiertos. No es un pronóstico." %}
<!DOCTYPE html>
<html lang="es-ES">
<head>
{% include "_head.html.j2" %}
</head>
<body data-updated-iso="{{ updated_iso }}" data-blackout="{{ '1' if in_blackout else '0' }}">

<div id="stale-banner" class="stale" hidden>
  <strong>⚠ Datos sin actualizar</strong> · la última ejecución fue hace <span id="stale-age">—</span> h. El cron diario del servidor (06:15 UTC) no se ha ejecutado. Se muestra el último agregado válido.
</div>

<header class="masthead">
  <div class="container">
    <div class="topbar">
      <div class="brand">
        <span class="mark"></span>
        <span class="brandname"><a href="/">{{ site_name }}</a></span>
        <span class="badge">OSINT</span>
      </div>
      <div class="status" id="hstatus">
        <button class="helpopen" id="helpbtn" aria-expanded="false" aria-controls="helppanel">? Ayuda</button>
        <button class="themebtn" data-theme-toggle aria-label="Cambiar entre tema claro y oscuro" title="Cambiar tema"><span class="ticon">☀</span><span class="tlabel">Claro</span></button>
        <div class="helpintro" id="helpintro" hidden>
    <div><strong>¿Primera vez?</strong> Te explico en 20 segundos cómo leer los datos.</div>
    <div class="helpintro-actions">
      <button class="btn" id="helpintro-open">Ver guía</button>
      <button class="helpintro-off" id="helpintro-off" aria-label="No mostrar">×</button>
    </div>
  </div>

  {% if in_blackout %}
        <span class="dot off"></span> BLACKOUT · datos retirados
        {% else %}
        <span class="dot"></span> EN VIVO · actualizado {{ updated_at }}
        {% endif %}
        {% if novedades %}
        <a class="novedad" href="#tab-agregado" title="Ultima ingesta de sondeos">
          <span class="ndot"></span>Nuevo sondeo · {{ novedades[0].pollster }} ({{ novedades[0].date[8:] }}/{{ novedades[0].date[5:7] }}){% if novedades|length > 1 %} +{{ novedades|length - 1 }}{% endif %}
        </a>
        {% endif %}
      </div>
    </div>

    <div class="hero">
      <p class="eyebrow">Elecciones generales · 29 de noviembre de 2026</p>
      <h1>Sondeos del 29N, con rango y sin pronóstico</h1>
      <p class="sub">Media móvil de los sondeos publicados. La incertidumbre va en el dato, no en una nota al pie.</p>

      <div class="hero-kpis">
        <div class="hk"><b>{{ days_to_election }}</b><span>días para el 29N</span></div>
        <div class="hk"><b>{{ n_polls }}</b><span>sondeos en la media</span></div>
        <div class="hk accent"><b>{% if gap_pp_psoe is not none %}+{{ "%.1f"|format(gap_pp_psoe) }}{% else %}—{% endif %}</b><span>puntos PP–PSOE{% if gap_pp_psoe_sin_cis is not none %}<br>sin CIS: +{{ "%.1f"|format(gap_pp_psoe_sin_cis) }}{% endif %}</span></div>
        <div class="hk"><b>176</b><span>mayoría absoluta</span></div>
      </div>

      <p class="stamp">
        {% if last_poll_date %}Último sondeo: <strong>{{ last_poll_date }}</strong> · {% endif %}
        Próximo blackout en <strong>{{ days_to_blackout }} días</strong> (24–28 nov) ·
        <a href="/data/latest.json">datos abiertos</a> · <a href="/robustez.html">robustez del dato</a> · <a href="/caveat.html">qué no dice</a>
      </p>
    </div>

    <nav class="tabs" role="tablist" aria-label="Secciones">
      <button class="tab active" data-tab="agregado" role="tab" aria-selected="true">Agregado</button>
      <button class="tab" data-tab="evolucion" role="tab" aria-selected="false">Evolución</button>
      <button class="tab" data-tab="congreso" role="tab" aria-selected="false">Congreso</button>
      <button class="tab" data-tab="senado" role="tab" aria-selected="false">Senado</button>
      <a class="tab" href="/electorado.html">Electorado</a>
      <a class="tab" href="/participacion.html">Participación</a>
      <a class="tab" href="/territorio.html">Territorio</a>
      <a class="tab" href="/circunscripciones.html">Circunscripciones</a>
      <a class="tab" href="/noche-electoral.html">Noche electoral</a>
    </nav>
    <div class="subnav">
      <a href="/metodologia.html">Metodología</a>
      <a href="/fuentes.html">Fuentes y datos</a>
      <a href="/factores.html">Factores</a>
      <a href="/comportamiento.html">Comportamiento</a>
      <a href="/caveat.html">Qué no dice</a>
      <a href="/apoyo.html">Apoyo</a>
      <a href="/sobre-mi.html">Sobre mí</a>
      <a href="/about.html">Acerca del proyecto</a>
    </div>
  </div>
</header>

<main class="container">

  {% if in_blackout %}
  <div class="alert"><strong>Blackout electoral activo</strong> · {{ blackout_reason }}. La agregación y sus JSON quedan retirados.</div>
  {% elif low_n %}
  <div class="alert warn"><strong>Pocos sondeos en la media</strong> · solo {{ n_polls }}. Interpreta el rango con cautela: una media con tan pocos datos no estabiliza la tendencia.</div>
  {% endif %}

  <!-- TAB: AGREGADO -->
  <section id="tab-agregado" class="tabpanel active" role="tabpanel">
    <div class="kpis">
      {% for p in parties_main[:4] %}
      <div class="kpi">
        <span class="kpi-name">{{ p.party }}</span>
        <b>{{ "%.1f"|format(p.mean) }}%</b>
        <span class="kpi-range">rango {{ "%.1f"|format(p.min) }}–{{ "%.1f"|format(p.max) }} · n={{ p.n }}{% if p.sample_total %} · {{ p.sample_n }}/{{ p.n }} con muestra ({{ "{:,}".format(p.sample_total)|replace(",", ".") }} encuestados){% endif %}</span>
      </div>
      {% endfor %}
    </div>

    <div class="card">
      <div class="cardhead"><h2>Calendario electoral</h2><span class="hint">próximo hito: {{ next_milestone }}</span></div>
      <div class="cal">
        {% for e in calendar %}
        <div class="calev {{ e.state }}"><b>{{ e.date }}</b><span>{{ e.label }}</span></div>
        {% endfor %}
      </div>
      <p class="muted small" style="margin-top:10px">Del 24 al 28 de noviembre no se publican ni difunden sondeos (JEC/LOREG). La agregación y sus JSON se retiran hasta el 29.</p>
    </div>

    {% if chart_svg %}
    <div class="card">
      <div class="cardhead"><h2>Evolución de los sondeos</h2><span class="hint">últimos 90 días · cada punto = un sondeo</span></div>
      <div class="chartwrap">{{ chart_svg|safe }}</div>
      <div class="legend">
        {% for l in chart_legend %}<span class="lg"><i style="background:{{ l.color }}"></i>{{ l.party }}</span>{% endfor %}
      </div>
      <p class="muted small" style="margin-top:6px">Eje vertical: media de voto (%). La <strong>línea gruesa</strong> es la media móvil de 14 días (centrada); los <strong>puntos</strong> son sondeos individuales (pasa el cursor para ver casa/fecha). Un punto aislado, como el CIS, no marca la tendencia: la media agregada es la de la tabla.</p>

    </div>
    {% endif %}

    <div class="card">
      <div class="cardhead"><h2>Media por partido</h2><span class="hint">{% if window_span %}{{ window_span }}{% endif %}{% if window_extended %} · ventana ampliada{% endif %}</span></div>
      <div class="tablewrap"><table>
        <thead><tr><th>Partido</th><th>Media</th><th>Sin CIS</th><th>Mediana</th><th>Mín</th><th>Máx</th><th>n (14 d)</th><th>Casas (45 d)</th><th>Casas (14 d)</th><th>IQR</th></tr></thead>
        <tbody>
        {% for p in parties_table %}
          <tr><td><strong>{{ p.party }}</strong>{% if p.n < 4 or (p.n_houses_recent and p.n_houses_recent < 3) %}<span title="n&lt;4 o menos de 3 casas en 14 d: media frágil" style="color:#f2c94c">*</span>{% endif %}</td><td class="num">{{ "%.2f"|format(p.mean) }}%</td><td class="num">{% if p.mean_sin_cis is not none %}{{ "%.2f"|format(p.mean_sin_cis) }}%{% else %}—{% endif %}</td><td class="num">{{ "%.2f"|format(p.median) }}%</td><td class="num">{{ "%.2f"|format(p.min) }}%</td><td class="num">{{ "%.2f"|format(p.max) }}%</td><td class="num">{{ p.n }}</td><td class="num">{% if p.n_houses_window %}{{ p.n_houses_window }}{% else %}—{% endif %}</td><td class="num">{% if p.n_houses_recent %}{{ p.n_houses_recent }}{% else %}—{% endif %}</td><td class="num">{% if p.iqr is not none %}{{ "%.1f"|format(p.iqr) }}{% else %}—{% endif %}</td></tr>
        {% endfor %}
        </tbody>
      </table></div>
      <p class="muted small"><strong>Mín–máx</strong> son los sondeos observados, no un intervalo de confianza: un solo sondeo puede fijar ambos extremos. La dispersión típica es el <strong>IQR</strong>. El <strong>CIS</strong> publica estimación de voto, no intención directa, y su efecto de casa es mayor. <strong>Sin CIS</strong> es una prueba de sensibilidad (misma media sin ese barómetro), no la media principal. <span style="color:#b45309">*</span> n&lt;4 o menos de 3 casas: media frágil.</p>
      <p class="muted small">«Otros» es el residual de las casas que lo publican; en Onda Cero incluye ERC, Junts, Bildu y PNV. Por eso los partidos territoriales van en la tabla de abajo y <strong>no se suman</strong> a la principal. Suma de la tabla: <strong>{{ "%.1f"|format(table_sum) }} %</strong> (las casas no listan todos los minoritarios). Actualizado: {{ updated_at }}. Ponderación: {{ weight_basis }}.{% if weights and weights.top_source %} Hoy el {{ "%.1f"|format(weights.top_source_share_pct) }} % del peso viene de <strong>{{ weights.top_source }}</strong> (la casa con más peso: <strong>{{ weights.top_house }}</strong>, {{ "%.1f"|format(weights.top_share_pct) }} %); <a href="/robustez.html#peso">ver el reparto</a>.{% endif %} <a href="/data/latest.json">Descargar JSON</a> · <a href="/metodologia.html">Cómo se calcula</a> · <a href="/como-leer.html">Cómo leer</a> · <a href="/glosario.html">Glosario</a></p>
      {% if parties_territorial %}
      <h3 style="margin:16px 0 6px;font-size:15px">Partidos territoriales</h3>
      <p class="muted small" style="margin:0 0 8px">Se presentan solo en algunas circunscripciones. En Onda Cero van dentro de «Otros»; por eso esta tabla <strong>no se suma</strong> a la principal. Su media es la de los sondeos que los desglosan.</p>
      <div class="tablewrap"><table>
        <thead><tr><th>Partido</th><th>Media</th><th>n (14 d)</th><th>Casas (45 d)</th><th>Casas (14 d)</th></tr></thead>
        <tbody>
        {% for p in parties_territorial %}
          <tr><td><strong>{{ p.party }}</strong></td><td class="num">{{ "%.2f"|format(p.mean) }}%</td><td class="num">{{ p.n }}</td><td class="num">{% if p.n_houses_window %}{{ p.n_houses_window }}{% else %}—{% endif %}</td><td class="num">{% if p.n_houses_recent %}{{ p.n_houses_recent }}{% else %}—{% endif %}</td></tr>
        {% endfor %}
        </tbody>
      </table></div>
      {% endif %}
    </div>

    <div class="card">
      <div class="cardhead"><h2>Preguntas frecuentes</h2></div>
      <details><summary><strong>¿Es un pronóstico?</strong></summary><p class="muted small">No. Es la media de sondeos publicados con su rango. No anticipa el resultado del 29N.</p></details>
      <details><summary><strong>¿Puedo publicar esto durante el blackout?</strong></summary><p class="muted small">No. Del 24 al 28 de noviembre de 2026 no se publican, difunden ni reproducen sondeos. La agregación y sus JSON se retiran.</p></details>
      <details><summary><strong>¿De dónde salen los datos?</strong></summary><p class="muted small">De sondeos publicados por Onda Cero (compilación), Electomanía (paneles propios) y el CIS, con enlace a la fuente y fecha. Se descartan autonómicos, adelantos incompletos y piezas sin ficha verificable.</p></details>
      <details><summary><strong>¿Por qué mostrar el rango y no solo la media?</strong></summary><p class="muted small">Porque la dispersión entre encuestadoras es parte del dato. Una cifra única oculta la incertidumbre.</p></details>
    </div>

    <div class="card" id="salud"><span id="robustez"></span>
      <div class="cardhead"><h2><a href="/robustez.html">Robustez del dato</a></h2><span class="hint">qué sostiene la media · <a href="/robustez.html">ficha completa →</a></span></div>
      {% if health %}
      {% set hlabel = {'ok':'Datos suficientes','warn':'Datos frágiles','bad':'Datos insuficientes'}[health.status] %}
      <div class="health">
        <span class="chip {{ health.status }}">{{ hlabel }}</span>
        <div class="healthitems">
          <span><b>{{ health.n_polls }}</b>sondeos</span>
          <span><b>{{ health.n_pollsters }}</b>encuestadoras</span>
          <span><b>{% if health.days_since_last is not none %}{{ health.days_since_last }}{% else %}—{% endif %}</b>días desde el último</span>
          <span><b>{% if health.sample_pct is not none %}{{ health.sample_pct }}%{% else %}—{% endif %}</b>con muestra declarada</span>
          <span><b>{% if health.dispersion_iqr is not none %}{{ "%.1f"|format(health.dispersion_iqr) }}{% else %}—{% endif %}</b>pp de dispersión (IQR)</span>
        </div>
      </div>
      {% if health.reasons %}
      <p class="muted small" style="margin-top:10px">Aviso: {{ health.reasons|join(' · ') }}. La media se publica igualmente, pero con menos estabilidad.</p>
      {% endif %}
      <p class="muted small" style="margin-top:10px">Qué mide esto: <a href="/metodologia.html#robustez">robustez del dato</a>. No es una nota de calidad, ni un pronóstico, ni una probabilidad.</p>
      <p class="muted small">Una sola encuestadora no es una media entre casas: es su serie. La salud mejora añadiendo sondeos de otras casas con fuente y muestra.</p>
      {% endif %}
    </div>

    {% if house_compare %}
    <div class="card">
      <div class="cardhead"><h2>Contraste por casa</h2><span class="hint">{{ house_mean.n_houses }} casas · última de cada una · 45 días</span></div>
      <div class="tablewrap">
        <table>
          <thead><tr><th>Partido</th><th>Media por casa</th><th>Rango</th><th>Casas</th><th>Media por sondeo</th><th>Diferencia</th></tr></thead>
          <tbody>
          {% for r in house_compare %}
            <tr><td>{{ r.party }}</td><td class="num">{{ fmt_pct(r.mean) }}%</td><td class="num">{{ fmt_pct(r.min) }}–{{ fmt_pct(r.max) }}</td><td class="num">{{ r.n_houses }}</td><td class="num">{% if r.poll_mean is not none %}{{ fmt_pct(r.poll_mean) }}%{% else %}—{% endif %}</td><td class="num">{% if r.diff is not none %}{{ "%+.2f"|format(r.diff) }} pp{% else %}—{% endif %}</td></tr>
          {% endfor %}
          </tbody>
        </table>
      </div>
      <p class="muted small">Última encuesta de cada casa en 45 días, <strong>mismo peso por casa</strong>. Es un contraste de robustez, no la media principal (que pesa cada sondeo por recencia). Incluye CIS (barómetro de octubre, n=5.025). La media por sondeo pondera por muestra; este contraste iguala el peso por casa.</p>
      <details style="margin-top:12px">
        <summary class="muted small" style="cursor:pointer"><strong>Último sondeo de cada casa</strong> (con método cuando difiere)</summary>
        <div class="tablewrap" style="margin-top:8px"><table>
          <thead><tr><th>Casa</th><th>Fecha</th><th>PP</th><th>PSOE</th><th>Muestra</th><th>Método</th></tr></thead>
          <tbody>
          {% for r in house_latest %}
            <tr><td>{{ r.pollster }}</td><td class="num">{{ r.date }}</td><td class="num">{% if r.pp is not none %}{{ fmt_pct(r.pp) }}%{% else %}—{% endif %}</td><td class="num">{% if r.psoe is not none %}{{ fmt_pct(r.psoe) }}%{% else %}—{% endif %}</td><td class="num">{% if r.sample %}{{ "{:,}".format(r.sample)|replace(",", ".") }}{% else %}—{% endif %}</td><td>{% if r.nota %}<span class="chip2">{{ r.nota }}</span>{% else %}—{% endif %}</td></tr>
          {% endfor %}
          </tbody>
        </table></div>
        <p class="muted small">El CIS estima voto (recuerdo y cocina propia); las demás casas publican intención directa. Por eso su valor no es comparable 1:1 y mueve los extremos del rango.</p>
      </details>
    </div>
    {% endif %}

    <div class="card">
      <div class="cardhead"><h2>Comparte o cita</h2></div>
      <p class="muted small">Si te sirve, compártelo con la fuente y el rango, no solo con la media.</p>
      <div class="share">
        <a href="https://bsky.app/intent/compose?text={{ (site_title ~ ' — media agregada con rango, no un pronóstico: ' ~ share_url)|urlencode }}" target="_blank" rel="noopener">Bluesky</a>
        <a href="https://mastodon.social/share?text={{ (site_title ~ ' — media agregada con rango, no un pronóstico: ' ~ share_url)|urlencode }}" target="_blank" rel="noopener">Mastodon</a>
        <a href="https://twitter.com/intent/tweet?text={{ (site_title ~ ' — media agregada con rango, no un pronóstico.')|urlencode }}&url={{ share_url|urlencode }}" target="_blank" rel="noopener">X</a>
        <a href="https://api.whatsapp.com/send?text={{ (site_title ~ ' ' ~ share_url)|urlencode }}" target="_blank" rel="noopener">WhatsApp</a>
      </div>
      <div class="cta">
        <a class="btn" href="/metodologia.html">Ver metodología</a>
        <a class="btn ghost" href="/caveat.html">Qué no dice este sitio</a>
      </div>
    </div>
  </section>


  <!-- TAB: EVOLUCIÓN -->
  <section id="tab-evolucion" class="tabpanel" role="tabpanel">
    <div class="card">
      <div class="cardhead"><h2>Variación de los sondeos en el tiempo</h2><span class="hint">{% if series_span %}{{ series_span }}{% endif %}</span></div>
      {% if sparks_svg %}
      {{ sparks_svg|safe }}
      <p class="muted small" style="margin-top:12px">Cifra grande = última media móvil de 14 días (centrada); delta = cambio de esa media móvil entre el inicio y el final del periodo. La línea es la media móvil y los puntos son sondeos individuales: un punto aislado (p. ej. CIS) no marca la tendencia. Solo se muestran los seis partidos con más media actual.</p>
      {% else %}
      <p class="muted">Aún no hay suficientes sondeos para mostrar una serie.</p>
      {% endif %}
    </div>
    {% if chart_svg %}
    <div class="card">
      <div class="cardhead"><h2>Vista conjunta</h2><span class="hint">últimos 90 días</span></div>
      <div class="chartwrap">{{ chart_svg|safe }}</div>
      <div class="legend">
        {% for l in chart_legend %}<span class="lg"><i style="background:{{ l.color }}"></i>{{ l.party }}</span>{% endfor %}
      </div>
      <p class="muted small" style="margin-top:6px">Eje vertical: media de voto (%). La <strong>línea gruesa</strong> es la media móvil de 14 días (centrada); los <strong>puntos</strong> son sondeos individuales (pasa el cursor para ver casa/fecha). Un punto aislado, como el CIS, no marca la tendencia: la media agregada es la de la tabla.</p>
    </div>
    {% endif %}
  </section>

  <!-- TAB: CONGRESO -->
  <section id="tab-congreso" class="tabpanel" role="tabpanel">
    <div class="alert warn"><strong>Simulación mecánica, no proyección.</strong> Aplico D'Hondt a la media nacional con un distrito único de 350 escaños y umbral del 3%, solo entre partidos estatales. La ley real reparte por provincias y los partidos territoriales (ERC, Junts, EH Bildu, PNV) no se simulan aquí: su ausencia infla el reparto de PP y PSOE. Sirve para ver el tamaño de los bloques, no para anticipar escaños ni mayorías.</div>

    <div class="card">
      <div class="cardhead"><h2>Simulación de bloques (D'Hondt nacional)</h2><span class="hint">350 escaños · umbral 3% · sin territoriales</span></div>
      {% if sim_congress %}
      <div class="seats">
        {% for name, seats in sim_congress.items() %}
        <div class="seatrow"><span class="sname">{{ name }}</span><span class="sbar"><i style="width:{{ (seats / 350 * 100)|round(1) }}%"></i></span><span class="snum">{{ seats }}</span></div>
        {% endfor %}
      </div>
      <p class="muted small">Total del reparto hipotético: {{ sim_congress.values()|sum }} escaños entre partidos estatales. Mayoría absoluta: 176. No es la composición real del Congreso.</p>
      {% else %}
      <p class="muted">Sin datos suficientes para simular.</p>
      {% endif %}
    </div>

    <div class="card">
      <div class="cardhead"><h2>Congreso de referencia</h2><span class="hint">composición vigente (23J-2023)</span></div>
      <div class="tablewrap"><table>
        <thead><tr><th>Partido</th><th>Escaños</th></tr></thead>
        <tbody>
        {% for name, seats in ref_congreso %}
          <tr><td>{{ name }}</td><td class="num">{{ seats }}</td></tr>
        {% endfor %}
        </tbody>
      </table></div>
      <p class="muted small">Es la composición actual como referencia. No es una proyección del 29N.</p>
    </div>

    <div class="card">
      <div class="cardhead"><h2>Bloques (media de voto)</h2></div>
      <div class="blocks">
        <div class="block"><span>PP + VOX</span><b>{% if bloc_right is not none %}{{ "%.1f"|format(bloc_right) }}%{% else %}—{% endif %}</b></div>
        <div class="block"><span>PSOE + SUMAR + Podemos</span><b>{% if bloc_left is not none %}{{ "%.1f"|format(bloc_left) }}%{% else %}—{% endif %}</b></div>
      </div>
      <p class="muted small">Suma de medias de voto, no de escaños. La traducción a escaños depende de las circunscripciones.</p>
    </div>
  </section>

  <!-- TAB: SENADO -->
  <section id="tab-senado" class="tabpanel" role="tabpanel">
    <div class="card">
      <div class="cardhead"><h2>Senado</h2><span class="hint">no se simula</span></div>
      <p class="muted">El Senado tiene <strong>265 escaños</strong>: <strong>208 electos</strong> en circunscripción provincial (4 por provincia, con excepciones insulares) y <strong>57 designados</strong> por las comunidades autónomas.</p>
      <p class="muted">No aplico una simulación porque el reparto depende de listas provinciales y de mayorías autonómicas, no de una media nacional. Cualquier cifra nacional sería un artefacto. Si aparece, se mostrará como <strong>referencia vigente</strong> y nunca como proyección.</p>
    </div>
    <div class="card">
      <div class="cardhead"><h2>Por qué el Congreso sí y el Senado no</h2></div>
      <p class="muted">El Congreso se puede aproximar con D'Hondt sobre una media nacional para ver el tamaño de los bloques, con todas las cautelas. El Senado se elige con listas abiertas y mayoritario plurinominal por provincia: una media nacional no informa del reparto. Simularlo daría una falsa precisión.</p>
      <div class="cta">
        <a class="btn ghost" href="/metodologia.html">Metodología</a>
        <a class="btn ghost" href="/caveat.html">Qué no dice este sitio</a>
      </div>
    </div>
  </section>

  <div class="card">
    <div class="cardhead"><h2>El electorado del 29N</h2><span class="hint">censo oficial · INE</span></div>
    {% if censo %}
    <p class="muted" style="margin:0 0 6px">
      <strong>{{ fmt_miles(censo.total) }}</strong> electores ·
      {{ fmt_miles(censo.cer) }} en España ·
      {{ fmt_miles(censo.cera) }} en el extranjero ·
      <strong>{{ fmt_miles(censo.nuevos_desde_2023) }}</strong> nuevos desde el 23-J-2023.
    </p>
    <div class="cta"><a class="btn" href="/electorado.html">Ver censo y distribución</a></div>
    {% endif %}
  </div>

  <div class="card">
    <div class="cardhead"><h2>Participación histórica</h2><span class="hint">1979–2023 · JEC</span></div>
    {% if part_kpis.n %}
    <p class="muted" style="margin:0 0 6px">
      En {{ part_kpis.ultima.eleccion }} votó el <strong>{{ fmt_pct(part_kpis.ultima.participacion) }} %</strong> del censo.
      El máximo desde 1979 fue {{ fmt_pct(part_kpis.max.participacion) }} % ({{ part_kpis.max.eleccion }});
      el mínimo, {{ fmt_pct(part_kpis.min.participacion) }} % ({{ part_kpis.min.eleccion }}).
    </p>
    <div class="cta"><a class="btn" href="/participacion.html">Ver la serie</a></div>
    {% endif %}
  </div>

  <div class="card">
    <div class="cardhead"><h2>Territorio y representación</h2><span class="hint">350 escaños · 52 circunscripciones</span></div>
    {% if escanos.provincias %}
    <p class="muted" style="margin:0 0 6px">
      {{ escanos_kpis.min.nombre }} elige {{ escanos_kpis.min.escanos }} diputados con {{ fmt_miles(escanos_kpis.min.electores) }} electores;
      {{ escanos_kpis.max.nombre }}, {{ escanos_kpis.max.escanos }} con {{ fmt_miles(escanos_kpis.max.electores) }}.
      Hay {{ (escanos_kpis.max.electores_por_escanos / escanos_kpis.min.electores_por_escanos)|round(1) }}× de diferencia por escaño.
    </p>
    <div class="cta"><a class="btn" href="/territorio.html">Ver el reparto</a> <a class="btn ghost" href="/circunscripciones.html">Ficha y calculadora por provincia</a></div>
    {% endif %}
  </div>

  <div class="card">
    <div class="cardhead"><h2>Más del ecosistema</h2></div>
    <p class="muted small">Si te interesa medir amplificación y coordinación informativa:</p>
