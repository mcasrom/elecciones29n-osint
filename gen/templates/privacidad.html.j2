{% set page_title = "Privacidad · observatorio electoral 29N" %}
{% set page_desc = "Qué datos guarda el aviso por correo del Observatorio 29N, para qué se usan y cómo darse de baja. Sin cookies ni perfilado." %}
{% set canonical = site_url ~ "/privacidad.html" %}
{% set jsonld = webpages['privacidad.html'] %}
<!DOCTYPE html>
<html lang="es-ES">
<head>
{% include "_head.html.j2" %}
