{% set page_title = "Metodología · observatorio electoral 29N 2026" %}
{% set page_desc = "Cómo se calcula cada dato: agregado de sondeos, censo, participación y escaños. Reglas comunes de fuente, validación y límites." %}
{% set canonical = site_url ~ "/metodologia.html" %}
{% set jsonld = webpages['metodologia.html'] %}
<!DOCTYPE html>
<html lang="es-ES">
<head>
{% include "_head.html.j2" %}
