{% set page_title = "Menciones de líderes · 29N" %}
{% set page_desc = "Frecuencia de menciones de Pedro Sánchez, Feijóo, Abascal y Yolanda Díaz en titulares de prensa española, a 24 horas y 7 días. No es intención de voto." %}
{% set canonical = site_url ~ "/menciones.html" %}
{% set jsonld = webpages['menciones.html'] %}
<!DOCTYPE html>
<html lang="es-ES">
<head>
{% include "_head.html.j2" %}
</head>
<body>
{% include "_nav.html.j2" %}
<main class="container">
  <h1 style="margin:18px 0 4px;font-size:30px;letter-spacing:-0.02em">Menciones de líderes</h1>
  <p class="muted" style="margin:0 0 12px">Cuántos titulares o sumarios de prensa española mencionan a cada líder en las últimas <strong>24 horas</strong> y <strong>7 días</strong>. Es presencia en el corpus, no apoyo, intención de voto ni actos de campaña.</p>
  <div class="alert warn"><strong>Qué mide:</strong> artículos periodísticos que nombran al líder. <strong>Qué no mide:</strong> popularidad, intención de voto, militancia, asistencia a actos ni valoración. Un titular puede mencionar a alguien para criticarlo.</div>
  <div class="grid" style="display:grid;grid-template-columns:1fr 1fr;gap:16px">
    <figure style="margin:0;background:#fff;border:1px solid var(--line);border-radius:10px;padding:10px">
      <img src="/img/lideres-1d.png" alt="Menciones de líderes en las últimas 24 horas" style="width:100%;height:auto;border-radius:6px" loading="lazy">
      <figcaption class="muted small">24 horas · titulares y sumarios</figcaption>
    </figure>
    <figure style="margin:0;background:#fff;border:1px solid var(--line);border-radius:10px;padding:10px">
      <img src="/img/lideres-7d.png" alt="Menciones de líderes en los últimos 7 días" style="width:100%;height:auto;border-radius:6px" loading="lazy">
      <figcaption class="muted small">7 días · titulares y sumarios</figcaption>
    </figure>
  </div>
  <div class="card" style="margin-top:16px"><div class="cardhead"><h2>Detalle</h2><span class="hint">artículos · % del corpus · días</span></div><div class="tablewrap"><table><thead><tr><th>Líder</th><th>24 h</th><th>7 días</th><th>Días con mención (7 d)</th></tr></thead><tbody id="menciones-body"><tr><td colspan="4" class="muted">Cargando…</td></tr></tbody></table></div><p class="muted small" id="menciones-meta">Fuente: titulares de prensa española. No se usan actos ni sondeos.</p></div>
  <div class="card"><div class="cardhead"><h2>Cómo leerlo</h2></div><ul class="muted small"><li>El corpus son titulares y sumarios de prensa; no es una muestra representativa de la sociedad.</li><li>Un artículo cuenta una vez por líder, aunque lo mencione varias veces.</li><li>La ventana de 24 h puede tener pocos artículos: mira siempre <code>n</code>.</li><li>La diferencia entre líderes puede reflejar agenda mediática, no intención de voto.</li><li>Fuente: <code>intelligence-hub/news.db</code>; actualización diaria.</li></ul></div>
  <div class="cta"><a class="btn" href="/lideres.html">Valoración CIS</a> <a class="btn ghost" href="/metodologia.html">Metodología</a> <a class="btn ghost" href="/caveat.html">Qué no dice</a> <a class="btn ghost" href="/data/menciones.json">JSON</a></div>
  <script>
  (function(){
    fetch('/data/menciones.json').then(function(r){return r.json();}).then(function(d){
      var body=document.getElementById('menciones-body'); if(!body) return;
      var one=d.windows['1'], seven=d.windows['7']; var by={};
      (seven.leaders||[]).forEach(function(x){by[x.name]=x;});
      body.innerHTML='';
      (one.leaders||[]).forEach(function(x){
        var s=by[x.name]||{articles:'—',share_pct:'—',days:'—'};
        var tr=document.createElement('tr');
        tr.innerHTML='<td><strong></strong></td><td class="num"></td><td class="num"></td><td class="num"></td>';
        tr.children[0].querySelector('strong').textContent=x.name;
        tr.children[1].textContent=x.articles+' ('+x.share_pct+' %)';
        tr.children[2].textContent=s.articles+' ('+s.share_pct+' %)';
        tr.children[3].textContent=s.days;
        body.appendChild(tr);
      });
      var meta=document.getElementById('menciones-meta');
      if(meta) meta.textContent='Fuente: titulares de prensa española · '+(one.n_articles||0)+' artículos en 24 h · '+(seven.n_articles||0)+' en 7 días · no es intención de voto.';
    }).catch(function(){});
  })();
  </script>
</main>
{% include "_footer.html.j2" %}
</body>
</html>
