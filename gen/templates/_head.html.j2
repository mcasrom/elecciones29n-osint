<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ page_title or site_title }}</title>
<meta name="description" content="{{ page_desc or site_desc }}">
<link rel="canonical" href="{{ canonical or (site_url ~ '/') }}">
<meta name="robots" content="index,follow,max-image-preview:large">
<link rel="stylesheet" href="/css/main.css?v={{ build_ts }}">
<script>(function(){try{var t=localStorage.getItem("e29n-theme");if(t!=="light"&&t!=="dark"){t=window.matchMedia("(prefers-color-scheme: light)").matches?"light":"dark";}document.documentElement.dataset.theme=t;}catch(e){}})();</script>
<script>
document.addEventListener('DOMContentLoaded', function(){
  function sync(){
    var light = document.documentElement.dataset.theme === 'light';
    document.querySelectorAll('[data-theme-toggle]').forEach(function(b){
      var i=b.querySelector('.ticon'), l=b.querySelector('.tlabel');
      if(i) i.textContent = light ? '☾' : '☀';
      if(l) l.textContent = light ? 'Oscuro' : 'Claro';
      b.setAttribute('title', light ? 'Cambiar a tema oscuro' : 'Cambiar a tema claro');
    });
  }
  sync();
  document.querySelectorAll('[data-theme-toggle]').forEach(function(b){
    b.addEventListener('click', function(){
      var root = document.documentElement;
      var next = root.dataset.theme === 'light' ? 'dark' : 'light';
      root.dataset.theme = next;
      try { localStorage.setItem('e29n-theme', next); } catch(e) {}
      sync();
    });
  });
});
</script>
<link rel="icon" href="/favicon.svg" type="image/svg+xml">
<link rel="icon" href="/favicon.ico" sizes="32x32">
<link rel="manifest" href="/manifest.webmanifest">
<link rel="apple-touch-icon" href="/icons/apple-touch-icon.png">
<meta name="theme-color" content="#0b0c1c">
<meta name="generator" content="{{ site_name }} v{{ version }}">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
<meta property="og:type" content="website">
<meta property="og:site_name" content="{{ site_name }}">
<meta property="og:locale" content="es_ES">
<meta property="og:title" content="{{ page_title or site_title }}">
<meta property="og:description" content="{{ page_desc or site_desc }}">
<meta property="og:url" content="{{ canonical or (site_url ~ '/') }}">
<meta property="og:image" content="{{ site_url }}/og.png">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ page_title or site_title }}">
<meta name="twitter:description" content="{{ page_desc or site_desc }}">
<meta name="twitter:image" content="{{ site_url }}/og.png">
<link rel="alternate" type="application/json" href="/data/latest.json" title="Datos agregados (JSON)">
<link rel="alternate" type="application/rss+xml" href="/cambios.xml" title="Cambios · nuevos sondeos">
<script type="application/ld+json">{{ jsonld|safe }}</script>
