<div class="helpbackdrop" id="helpbackdrop" hidden></div>
<aside class="helppanel" id="helppanel" role="dialog" aria-modal="true" aria-labelledby="helptitle" hidden>
  <div class="helphead">
    <h2 id="helptitle">Cómo leer el observatorio</h2>
    <button class="helpclose" id="helpclose" aria-label="Cerrar ayuda">×</button>
  </div>
  <ol class="helpsteps">
    <li><strong>Sondeos ≠ pronóstico.</strong> Es la media de los sondeos publicados, con rango mínimo–máximo. El rango no es un intervalo de confianza.</li>
    <li><strong>Tres capas distintas.</strong> Quién puede votar (censo), quién vota (participación) y cómo se traduce (territorio).</li>
    <li><strong>Datos oficiales.</strong> Censo (INE), participación (JEC) y escaños (BOE) no son estimaciones. Los sondeos sí.</li>
    <li><strong>Lo que no dice.</strong> No predice el resultado ni atribuye preferencias por edad, sexo o territorio.</li>
  </ol>
  <div class="cta">
    <a class="btn" href="/metodologia.html">Ver metodología</a>
    <a class="btn ghost" href="/caveat.html">Qué no dice este sitio</a>
  </div>
</aside>
<script>
(function(){
  var btn = document.getElementById('helpbtn');
  var panel = document.getElementById('helppanel');
  var bd = document.getElementById('helpbackdrop');
  var close = document.getElementById('helpclose');
  if (!btn || !panel) return;
  var open = false;
  function setOpen(v){
    open = v;
    panel.hidden = !v;
    bd.hidden = !v;
    btn.setAttribute('aria-expanded', v ? 'true' : 'false');
    document.body.style.overflow = v ? 'hidden' : '';
    if (v) close.focus();
  }
  btn.addEventListener('click', function(){ setOpen(true); });
  close.addEventListener('click', function(){ setOpen(false); });
  bd.addEventListener('click', function(){ setOpen(false); });
  document.addEventListener('keydown', function(e){ if (e.key === 'Escape' && open) setOpen(false); });
  var intro = document.getElementById('helpintro');
  var INTRO_KEY = 'e29n_help_intro';
  if (intro) {
    try {
      if (!localStorage.getItem(INTRO_KEY)) intro.hidden = false;
    } catch(e) {}
    var io = document.getElementById('helpintro-open');
    var ic = document.getElementById('helpintro-off');
    if (io) io.addEventListener('click', function(){
      intro.hidden = true; setOpen(true);
      try { localStorage.setItem(INTRO_KEY, 'off'); } catch(e) {}
    });
    if (ic) ic.addEventListener('click', function(){
      intro.hidden = true;
      try { localStorage.setItem(INTRO_KEY, 'off'); } catch(e) {}
    });
  }
})();
</script>

<div class="swupdate" id="swupdate" data-build="{{ build_ts }}" hidden>
  <span><strong>Nueva versión disponible.</strong> Recarga para ver los últimos datos.</span>
  <button id="swupdate-btn" type="button">Recargar</button>
  <button id="swupdate-close" type="button" aria-label="Cerrar aviso"
    onclick="var b=document.getElementById('swupdate');if(b){b.hidden=true;}try{sessionStorage.setItem('e29n_sw_hidden','{{ build_ts }}');}catch(e){}">×</button>
</div>
<script>
if ('serviceWorker' in navigator) {
  window.addEventListener('load', function(){
    var box = document.getElementById('swupdate');
    var btn = document.getElementById('swupdate-btn');
    var close = document.getElementById('swupdate-close');
    var reg = null;
    var userClicked = false;
    var DISMISS = 'e29n_sw_dismiss';
    function isDismissed(){
      try { return !!(reg && reg.waiting && localStorage.getItem(DISMISS) === reg.waiting.scriptURL); }
      catch(e) { return false; }
    }
    function isHiddenHere(){
      try { return sessionStorage.getItem('e29n_sw_hidden') === (box && box.dataset.build); }
      catch(e) { return false; }
    }
    function show(){ if (box && !isDismissed() && !isHiddenHere()) box.hidden = false; }
    if (close) close.addEventListener('click', function(){
      box.hidden = true;
      try { if (reg && reg.waiting) localStorage.setItem(DISMISS, reg.waiting.scriptURL); } catch(e) {}
    });
    if (btn) btn.addEventListener('click', function(){
      box.hidden = true;
      userClicked = true;
      if (reg && reg.waiting) reg.waiting.postMessage({type: 'SKIP_WAITING'});
    });
    navigator.serviceWorker.register('/sw.js?v={{ build_ts }}', {updateViaCache: 'none'}).then(function(r){
      reg = r;
      if (r.waiting && navigator.serviceWorker.controller) show();
      r.addEventListener('updatefound', function(){
        var nw = r.installing;
        if (!nw) return;
        nw.addEventListener('statechange', function(){
          if (nw.state === 'installed' && navigator.serviceWorker.controller) show();
        });
      });
    }).catch(function(){});
    navigator.serviceWorker.addEventListener('controllerchange', function(){ if (userClicked) window.location.reload(); });
  });
}
</script>
