{% set page_title = "Participación en las elecciones generales · 1979–2023" %}
{% set page_desc = "Evolución de la participación nacional en las elecciones generales de España desde 1979: última cita, media histórica, máximo y mínimo, con enlace a la JEC." %}
{% set canonical = site_url ~ "/participacion.html" %}
{% set jsonld = part_jsonld %}
<!DOCTYPE html>
<html lang="es-ES">
<head>
{% include "_head.html.j2" %}
</head>
<body>
{% include "_nav.html.j2" %}
<main class="container">
  <h1 style="margin:18px 0 4px;font-size:30px;letter-spacing:-0.02em">Participación en las elecciones generales</h1>
  <p class="muted" style="margin:0 0 14px">Serie nacional desde 1979. Cada dato enlaza a la tabla de resultados de la Junta Electoral Central.</p>

  {% if part_kpis.n %}
  <div class="kpis">
    <div class="kpi"><span class="kpi-name">Última cita · {{ part_kpis.ultima.eleccion }}</span><b>{{ fmt_pct(part_kpis.ultima.participacion) }}%</b><span class="kpi-range">sobre censo</span></div>
    <div class="kpi"><span class="kpi-name">Media histórica</span><b>{{ fmt_pct(part_kpis.media) }}%</b><span class="kpi-range">{{ part_kpis.n }} elecciones</span></div>
    <div class="kpi"><span class="kpi-name">Máximo</span><b>{{ fmt_pct(part_kpis.max.participacion) }}%</b><span class="kpi-range">{{ part_kpis.max.eleccion }}</span></div>
    <div class="kpi"><span class="kpi-name">Mínimo</span><b>{{ fmt_pct(part_kpis.min.participacion) }}%</b><span class="kpi-range">{{ part_kpis.min.eleccion }}</span></div>
  </div>

  <div class="card">
    <div class="cardhead"><h2>Evolución de la participación</h2><span class="hint">1979–2023 · % sobre censo</span></div>
    {{ part_chart|safe }}
    <p class="muted small" style="margin-top:8px">Cada punto es una elección general. No se proyecta la participación del 29N.</p>
  </div>

  <div class="card">
    <div class="cardhead"><h2>Participación por provincia</h2><span class="hint">1977–2023 · elige una provincia</span></div>
    <div class="chart-controls">
      <label for="provSel">Provincia</label>
      <select id="provSel"></select>
    </div>
    <div id="provChart" class="chartwrap"></div>
    <p class="muted small">Línea naranja: provincia seleccionada. Línea azul: media nacional. Cada punto es una elección general.</p>
  </div>

  <div class="card">
    <div class="cardhead"><h2>2023 por provincia</h2><span class="hint">participación sobre censo</span></div>
    <div class="tablewrap">
      <table>
        <thead><tr><th>Provincia</th><th>Electores</th><th>Votantes</th><th>Participación</th></tr></thead>
        <tbody>
        {% for p in prov_2023|sort(attribute='participacion', reverse=true) %}
          <tr><td>{{ p.nombre }}</td><td class="num">{{ fmt_miles(p.electores) }}</td><td class="num">{{ fmt_miles(p.votantes) }}</td><td class="num">{{ fmt_pct(p.participacion) }}%</td></tr>
        {% endfor %}
        </tbody>
      </table>
    </div>
    <p class="muted small"><a href="/data/participacion-provincial.json">Serie provincial completa (JSON)</a> · <a href="/data/participacion.csv">Serie nacional (CSV)</a></p>
  </div>

  <div class="card">
    <div class="cardhead"><h2>Serie por elección</h2><span class="hint">enlace a la JEC</span></div>
    <div class="tablewrap">
      <table>
        <thead><tr><th>Elección</th><th>Participación</th><th>Fuente</th></tr></thead>
        <tbody>
        {% for r in participacion.elecciones|reverse %}
          <tr>
            <td>{{ r.eleccion }}</td>
            <td class="num">{{ fmt_pct(r.participacion) }}%</td>
            <td>{% if r.fuente_url %}<a href="{{ r.fuente_url }}" rel="noopener" target="_blank">JEC</a>{% endif %}</td>
          </tr>
        {% endfor %}
        </tbody>
      </table>
    </div>
    <p class="muted small"><a href="/data/participacion.csv">Descargar CSV</a> · serie normalizada a partir de las tablas de la JEC.</p>
  </div>

  <div class="card">
    <div class="cardhead"><h2>Fuente y límites</h2></div>
    <ul class="muted small">
      <li><strong>Participación nacional</strong> sobre el censo de cada convocatoria. No es una estimación: es el dato oficial.</li>
      <li>La <strong>participación por provincia/CCAA</strong> requiere el desglose territorial del Ministerio del Interior; se añadirá cuando la fuente sea accesible y verificable.</li>
      <li>La cita del <strong>29N-2026</strong> se incorporará <strong>después</strong> de la jornada electoral. Antes no hay dato que mostrar.</li>
      <li>Una participación alta o baja no explica por sí sola el resultado: mide cuántos votaron, no a quién.</li>
    </ul>
    <div class="cta">
      <a class="btn" href="/electorado.html">Ver el censo</a>
      <a class="btn ghost" href="/">Ver los sondeos</a>
    </div>
  </div>
  {% else %}
  <div class="alert warn">La serie de participación no está disponible todavía. <a href="/">Volver al agregado</a>.</div>
  {% endif %}
  {% include "_captura.html.j2" %}
</main>
{% include "_footer.html.j2" %}
<script>
(function(){
  var sel=document.getElementById('provSel'), box=document.getElementById('provChart');
  if(!sel||!box) return;
  fetch('/data/participacion-provincial.json').then(function(r){return r.json()}).then(function(d){
    var els=Object.keys(d.elecciones).sort();
    var provs=[];
    els.forEach(function(k){ d.elecciones[k].provincias.forEach(function(p){ if(provs.indexOf(p.nombre)<0) provs.push(p.nombre); }); });
    provs.sort();
    sel.innerHTML=provs.map(function(p){return '<option>'+p+'</option>';}).join('');
    var def=provs.indexOf('Madrid')>=0?'Madrid':provs[0];
    sel.value=def;
    function svg(series,nat,name){
      var W=760,H=300,pl=42,pr=16,pt=18,pb=34;
      var vals=series.concat(nat).map(function(x){return x.v}).filter(function(v){return v!=null});
      var vmin=Math.max(0,Math.min.apply(null,vals)-3), vmax=Math.max.apply(null,vals)+3;
      function X(i){return pl+(W-pl-pr)*i/(series.length-1)}
      function Y(v){return pt+(H-pt-pb)*(1-(v-vmin)/(vmax-vmin))}
      var grid='';
      for(var g=0;g<5;g++){var v=vmin+(vmax-vmin)*g/4;var y=Y(v);grid+='<line x1="'+pl+'" y1="'+y+'" x2="'+(W-pr)+'" y2="'+y+'" stroke="var(--line)"/><text x="6" y="'+(y+4)+'" fill="var(--muted)" font-size="11">'+v.toFixed(0)+'%</text>'}
      var p1=series.map(function(x,i){return (i?'L':'M')+X(i)+','+Y(x.v)}).join(' ');
      var p2=nat.map(function(x,i){return (i?'L':'M')+X(i)+','+Y(x.v)}).join(' ');
      var labels=''; els.forEach(function(k,i){ if(i%2===0||i===els.length-1) labels+='<text x="'+X(i)+'" y="'+(H-10)+'" fill="var(--muted)" font-size="10" text-anchor="middle">'+k.slice(0,4)+'</text>' });
      var dots=series.map(function(x,i){return '<circle cx="'+X(i)+'" cy="'+Y(x.v)+'" r="2.6" fill="#ff5a1f"/>'}).join('');
      return '<svg class="chart" viewBox="0 0 '+W+' '+H+'">'+grid+'<path d="'+p2+'" fill="none" stroke="#8ec5ff" stroke-width="1.6" opacity=".75"/><path d="'+p1+'" fill="none" stroke="#ff5a1f" stroke-width="2.2"/>'+dots+labels+'</svg><div class="legend"><span class="lg"><i style="background:#ff5a1f"></i>'+name+'</span><span class="lg"><i style="background:#8ec5ff"></i>Nacional</span></div>';
    }
    function draw(name){
      var series=[], nat=[];
      els.forEach(function(k){
        var pr=d.elecciones[k].provincias.filter(function(p){return p.nombre===name})[0];
        series.push({v:pr?pr.participacion:null}); nat.push({v:d.elecciones[k].nacional.participacion});
      });
      box.innerHTML=svg(series,nat,name);
    }
    sel.addEventListener('change',function(){draw(sel.value)});
    draw(def);
  }).catch(function(){ box.innerHTML='<p class="muted small">No se pudo cargar la serie provincial.</p>'; });
})();
</script>
</body>
</html>
